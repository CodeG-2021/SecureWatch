# Application
APP_ENV=local
APP_NAME=securewatch
LOG_LEVEL=debug

# Frontend
WEB_PORT=3000
API_BASE_URL=http://localhost:8080

# API Gateway
API_GATEWAY_PORT=8080
API_GATEWAY_REQUIRE_AUTH=true
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
AUTH_SERVICE_URL=http://auth-service:8081
CASE_SERVICE_URL=http://case-service:8082
EVIDENCE_SERVICE_URL=http://evidence-service:8083

# Auth Service
AUTH_SERVICE_PORT=8081

# Case Service
CASE_SERVICE_PORT=8082

# Evidence Service
EVIDENCE_SERVICE_PORT=8083

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=securewatch
POSTGRES_USER=securewatch
POSTGRES_PASSWORD=local-dev-password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=securewatch
RABBITMQ_DEFAULT_PASS=local-dev-password
RABBITMQ_URL=amqp://securewatch:local-dev-password@localhost:5672/

# MinIO  (min 8 chars required)
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=securewatch
MINIO_ROOT_PASSWORD=local-dev-password
MINIO_BUCKET_EVIDENCE=securewatch-evidence
MINIO_BUCKET_REPORTS=securewatch-reports
MINIO_BUCKET_ARTIFACTS=securewatch-artifacts

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-dev-admin
