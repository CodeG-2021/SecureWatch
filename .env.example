# Application
APP_ENV=local
APP_NAME=securewatch
LOG_LEVEL=debug

# Frontend
WEB_PORT=3000
API_BASE_URL=http://localhost:8080

# API Gateway
API_GATEWAY_PORT=8080
API_GATEWAY_REQUIRE_AUTH=true
JWT_SECRET=change-me-in-local-env
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
AUTH_SERVICE_URL=http://auth-service:8081

# Auth Service
AUTH_SERVICE_PORT=8081

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=securewatch
POSTGRES_USER=securewatch
POSTGRES_PASSWORD=securewatch

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=securewatch
RABBITMQ_DEFAULT_PASS=securewatch
RABBITMQ_URL=amqp://securewatch:securewatch@localhost:5672/

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=securewatch
MINIO_ROOT_PASSWORD=securewatch123
MINIO_BUCKET_EVIDENCE=securewatch-evidence
MINIO_BUCKET_REPORTS=securewatch-reports
MINIO_BUCKET_ARTIFACTS=securewatch-artifacts

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
